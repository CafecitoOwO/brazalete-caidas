<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de la lista de cuidadores o de pacientes: quien es, cuando
     fue la ultima vez que dio señales, y un boton para avisarle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <View
        android:id="@+id/luzP"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:background="@drawable/circulo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nombreP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Persona"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detalleP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="@color/apagado"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAvisarP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/borde"
        android:minWidth="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Avisar"
        android:textColor="@color/texto"
        android:textSize="12sp" />
</LinearLayout>
