<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brazalete"
                android:textColor="@color/texto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subestado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Detenido  ·  Sin conexion"
                android:textColor="@color/apagado"
                android:textSize="13sp" />

            <!-- Estado del paciente (solo modo cuidador) -->
            <LinearLayout
                android:id="@+id/tarjetaCuidador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@color/tarjeta"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO DEL PACIENTE"
                    android:textColor="@color/apagado"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/estadoPaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sin datos"
                    android:textColor="@color/apagado"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/infoPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Esperando al brazalete."
                    android:textColor="@color/apagado"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Deteccion -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@color/tarjeta"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETECCION DE CAIDAS"
                    android:textColor="@color/apagado"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/estadoVig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Detenida"
                    android:textColor="@color/texto"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/datosSensor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:text="Sin datos del sensor"
                    android:textColor="@color/apagado"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/notaSegundoPlano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Funciona con la pantalla apagada y con otras apps abiertas."
                    android:textColor="@color/verde"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/btnVigilar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/texto"
                android:text="Iniciar vigilancia"
                android:textColor="@color/fondo"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDemo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/borde"
                    android:text="Simular caida"
                    android:textColor="@color/texto"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/borde"
                    android:text="SOS"
                    android:textColor="@color/rojo"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Ajustes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/tarjeta"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONEXION"
                    android:textColor="@color/apagado"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Codigo de sala (igual en los dos telefonos)"
                    android:textColor="@color/apagado"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/campoSala"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="text"
                    android:textColor="@color/texto"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/grupoModo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/modoBrazalete"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Brazalete"
                        android:textColor="@color/texto" />

                    <RadioButton
                        android:id="@+id/modoCuidador"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cuidador"
                        android:textColor="@color/texto" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/borde"
                    android:text="Guardar y reconectar"
                    android:textColor="@color/texto"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCompartir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/borde"
                    android:text="Enviar enlace al cuidador"
                    android:textColor="@color/texto"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Proyecto escolar. No es un dispositivo medico."
                android:textColor="@color/apagado"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Pantalla de alerta -->
    <LinearLayout
        android:id="@+id/pantallaAlerta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/rojoFuerte"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/alertaTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Posible caida detectada"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alertaCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="25"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alertaTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Si estas bien, cancela antes de que acabe la cuenta."
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/alertaDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnEstoyBien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FFFFFF"
            android:text="Estoy bien, cancelar"
            android:textColor="#111417"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLlamar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#33FFFFFF"
            android:text="Llamar a emergencias"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
